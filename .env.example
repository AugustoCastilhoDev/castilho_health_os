POSTGRES_USER=chos_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=castilho_health

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_TTL=24h

# Cloudflare R2 (optional — leave all four blank to run without document
# upload; see ROADMAP.md for how to create a scoped R2 API token).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Memed digital prescription (optional — leave both blank to run without
# prescription issuance). Memed publishes a shared sandbox key pair in its
# own public docs (doc.memed.com.br) for testing before a commercial/
# production key pair is issued; see ROADMAP.md.
MEMED_API_KEY=
MEMED_SECRET_KEY=
# Both below already default to Memed's public sandbox — only set them to
# switch to production once Memed issues those keys.
MEMED_API_URL=
MEMED_FRONTEND_SCRIPT_URL=
